#! /usr/bin/env sh

BOLD=''
MUTED=''
RESET=''
RED_BOLD=''

if [ -t 1 ]; then
  BOLD='\033[1m'
  MUTED='\033[0;2m'
  RESET='\033[0m'
  RED_BOLD='\033[1;31m'
fi

VERSION=${1}

if [ -z "${VERSION}" ]; then
  echo ""
  echo "${RED_BOLD}Missing image version argument${RESET}"
  echo ""
  echo "${MUTED}Usage:${RESET}"
  echo ""
  echo "    ${MUTED}${0}${RESET} ${BOLD}0.1.0${BOLD}"
  echo ""

  exit 1
fi

if [ -z "${COMMIT_SHA:-}" ] && command -v git >/dev/null 2>&1; then
  COMMIT_SHA="$(git rev-parse HEAD)"
fi

docker --context=default buildx build \
  -t "ghcr.io/grua-io/maintenance-in-progress:${VERSION}-arm64" \
  --label "maintainer=rwillians" \
  --label "org.opencontainers.image.source=https://github.com/grua-io/maintenance-in-progress" \
  --label "org.opencontainers.image.revision=${COMMIT_SHA}" \
  --builder default \
  --platform linux/arm64 \
  --push .

docker --context=default buildx build \
  -t "ghcr.io/grua-io/maintenance-in-progress:${VERSION}-amd64" \
  --label "maintainer=rwillians" \
  --label "org.opencontainers.image.source=https://github.com/grua-io/maintenance-in-progress" \
  --label "org.opencontainers.image.revision=${COMMIT_SHA}" \
  --builder default \
  --platform linux/amd64 \
  --push .

docker buildx imagetools create \
  -t "ghcr.io/grua-io/maintenance-in-progress:latest" \
  -t "ghcr.io/grua-io/maintenance-in-progress:${VERSION}" \
  "ghcr.io/grua-io/maintenance-in-progress:${VERSION}-arm64" \
  "ghcr.io/grua-io/maintenance-in-progress:${VERSION}-amd64"
